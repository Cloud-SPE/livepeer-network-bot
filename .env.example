# --- required -------------------------------------------------------------

# Base URL of the Livepeer protocol explorer API (no trailing slash needed).
EXPLORER_BASE_URL=https://livepeer-network-api.cloudspe.com

# Discord webhook URL to which all public-channel embeds are POSTed.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME

# SQLite connection string. Use `sqlite://path/to/file.db` for a file-backed
# DB or `sqlite::memory:` for ephemeral. The path is created on first run.
DATABASE_URL=sqlite://./livepeer-payout-bot.db

# --- optional: webhook-only behavior (defaults shown) --------------------

# How often the event poller hits /api/v1/events.
EVENT_POLL_INTERVAL_SECS=60

# Length of one digest window. The digest poster wakes up on wall-clock
# WINDOW boundaries (for example 00, 15, 30, 45 past the hour when 900)
# and drains pending unsent tickets.
DIGEST_WINDOW_SECS=900

# Max unsent winning-ticket rows processed in one digest run. Keeps backlog
# draining bounded while the Discord webhook client enforces rate limits.
DIGEST_FETCH_LIMIT=500

# How often the summary poster checks whether a daily/weekly/monthly
# summary is due. The actual post happens at most once per period_date.
SUMMARY_POLL_INTERVAL_SECS=3600

# How often the reward poller hits /api/v1/events?event_name=Reward
# and dispatches per-event DMs to subscribers. Only spawned when
# COMMANDS_ENABLED=true.
REWARD_POLL_INTERVAL_SECS=60

# How often the delegator poller hits /api/v1/events for Bond/Unbond/Rebond.
# Persists into delegator_events for the subscriber digest fan-out. Only
# spawned when COMMANDS_ENABLED=true.
DELEGATOR_POLL_INTERVAL_SECS=60

# How often the subscriber digest poster fires. Per-subscriber DMs covering
# all Bond/Unbond/Rebond activity in this window for each subscribed orch.
# Only spawned when COMMANDS_ENABLED=true.
SUBSCRIBER_DIGEST_INTERVAL_SECS=900

# HTTP client timeout for explorer + Discord calls.
HTTP_TIMEOUT_SECS=30

# Logging filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx::query=warn

# User-Agent header sent with all outbound HTTP requests.
USER_AGENT=livepeer-payout-bot/0.1

# --- optional: slash commands (disabled by default) ----------------------
#
# When COMMANDS_ENABLED=true, the bot opens a gateway connection and serves
# slash commands. Requires a Discord application + bot user; create one at
# https://discord.com/developers/applications, copy the bot token + app ID
# into the variables below, and invite the bot to your server with the
# `applications.commands` OAuth2 scope.

COMMANDS_ENABLED=false

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# When set, commands are registered to that guild only (instant updates,
# useful during development). When empty, commands register globally
# (~1 hour propagation per Discord docs).
DISCORD_GUILD_ID=

# Per-user cap enforced by /subscribe.
MAX_SUBSCRIPTIONS_PER_USER=25

# Consecutive 403 DM failures before a subscription is auto-removed.
# Used by 004c; field already exists on the subscriptions row.
DM_FAILURE_AUTO_UNSUB=3
