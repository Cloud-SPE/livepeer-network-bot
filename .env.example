# --- required -------------------------------------------------------------

# Base URL of the Livepeer protocol explorer API (no trailing slash needed).
EXPLORER_BASE_URL=https://livepeer-network-api.cloudspe.com

# Discord webhook URL to which all embeds are POSTed.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME

# SQLite connection string. Use `sqlite://path/to/file.db` for a file-backed
# DB or `sqlite::memory:` for ephemeral. The path is created on first run.
DATABASE_URL=sqlite://./livepeer-payout-bot.db

# --- optional (defaults shown) -------------------------------------------

# How often the event poller hits /api/v1/events.
EVENT_POLL_INTERVAL_SECS=60

# Length of one digest window. The digest poster wakes up every WINDOW
# seconds and emits embeds for unsent tickets in the prior window.
DIGEST_WINDOW_SECS=900

# How often the summary poster checks whether a daily/weekly/monthly
# summary is due. The actual post happens at most once per period_date.
SUMMARY_POLL_INTERVAL_SECS=3600

# HTTP client timeout for explorer + Discord calls.
HTTP_TIMEOUT_SECS=30

# Logging filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx::query=warn

# User-Agent header sent with all outbound HTTP requests.
USER_AGENT=livepeer-payout-bot/0.1
