# Published container image used by infra/build-images.sh.
IMAGE=tztcloud/livepeer-network-bot:latest

# --- required -------------------------------------------------------------

EXPLORER_BASE_URL=https://livepeer-network-api.cloudspe.com
# Single server: one URL. Multiple servers: comma-separated webhooks, one per
# server channel (digests/summaries fan out to all of them, best-effort).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME

# Persist the SQLite DB in the mounted ./data directory from docker-compose.
DATABASE_URL=sqlite:///data/livepeer-payout-bot.db

# --- optional: webhook-only behavior --------------------------------------

EVENT_POLL_INTERVAL_SECS=60

# Runs on wall-clock boundaries (00, 15, 30, 45 past the hour when 900).
DIGEST_WINDOW_SECS=900
DIGEST_FETCH_LIMIT=500
WEBHOOK_POST_ENABLED=true

SUMMARY_POLL_INTERVAL_SECS=3600
REWARD_POLL_INTERVAL_SECS=60
DELEGATOR_POLL_INTERVAL_SECS=60
SUBSCRIBER_DIGEST_INTERVAL_SECS=900

HTTP_TIMEOUT_SECS=30
RUST_LOG=info,sqlx::query=warn
USER_AGENT=livepeer-payout-bot/0.1

# --- optional: slash commands ---------------------------------------------

COMMANDS_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
MAX_SUBSCRIPTIONS_PER_USER=25
DM_FAILURE_AUTO_UNSUB=3
